{
  "include": "\"${SWAY_NOIR_THEME_DIR}/waybar/base.jsonc\"",
  "height": 34,
  "margin-left": 8,
  "margin-right": 8,
  "sway/window": {
    "max-length": 50,
    "rewrite": {
      "(.*) (?:-|—) Mozilla Firefox(.*)": "$1 - Firefox$2",
      "(.*) - Visual Studio Code": "$1 - VS Code"
    }
  },
  "network": {"max-length": 50},
  "memory": {"tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"}
}
