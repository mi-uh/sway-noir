{
  "layer": "top",
  "position": "bottom",
  "height": 36,
  "spacing": 0,
  "fixed-center": true,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "reload_style_on_change": true,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["pulseaudio", "network", "battery", "cpu", "memory", "tray", "clock"],
  "sway/workspaces": {
    "all-outputs": false,
    "disable-scroll": true,
    "format": "{name}"
  },
  "sway/mode": {"format": "{mode}"},
  "sway/window": {"format": "{title}", "max-length": 32, "align": 0.5},
  "cpu": {
    "format": "<span size=\"small\" foreground=\"{{muted}}\">CPU</span>  <span weight=\"semibold\">{usage:02}</span>",
    "interval": 3,
    "align": 0.5,
    "justify": "center",
    "tooltip": false
  },
  "memory": {
    "format": "<span size=\"small\" foreground=\"{{muted}}\">MEM</span>  <span weight=\"semibold\">{percentage:02}</span>",
    "interval": 5,
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },
  "network": {
    "align": 0.5,
    "justify": "center",
    "format-wifi": "<span size=\"small\" foreground=\"{{muted}}\">WIFI</span>  <span weight=\"semibold\">{signalStrength}</span>",
    "format-ethernet": "<span size=\"small\" foreground=\"{{muted}}\">NET</span>  <span weight=\"semibold\">ETH</span>",
    "format-disconnected": "<span size=\"small\" foreground=\"{{muted}}\">NET</span>  <span weight=\"semibold\">OFF</span>",
    "tooltip-format-wifi": "{essid} - {ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname} - {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected"
  },
  "pulseaudio": {
    "align": 0.5,
    "justify": "center",
    "format": "<span size=\"small\" foreground=\"{{muted}}\">VOL</span>  <span weight=\"semibold\">{volume}</span>",
    "format-muted": "<span size=\"small\" foreground=\"{{muted}}\">VOL</span>  <span weight=\"semibold\">MUTE</span>",
    "scroll-step": 2,
    "on-click": "\"$SWAY_NOIR_DIR/session/optional-command\" --shell audio-settings \"${SWAY_NOIR_AUDIO_SETTINGS_COMMAND-pavucontrol}\""
  },
  "battery": {
    "align": 0.5,
    "justify": "center",
    "states": {"warning": 30, "critical": 15},
    "format": "<span size=\"small\" foreground=\"{{muted}}\">PWR</span>  <span weight=\"semibold\">{capacity}</span>",
    "format-charging": "<span size=\"small\" foreground=\"{{muted}}\">PWR</span>  <span weight=\"semibold\">{capacity}+</span>",
    "format-plugged": "<span size=\"small\" foreground=\"{{muted}}\">PWR</span>  <span weight=\"semibold\">{capacity}+</span>",
    "format-full": "<span size=\"small\" foreground=\"{{muted}}\">PWR</span>  <span weight=\"semibold\">FULL</span>"
  },
  "tray": {"spacing": 6, "icon-size": 16},
  "clock": {
    "align": 0.5,
    "format": "{:%m-%d · %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  }
}
