#!/usr/bin/bash
set -euo pipefail

if (( $# < 3 )); then
    printf 'Missing lock, PolicyKit agent or Gammastep command\n' >&2
    exit 2
fi

profile_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly profile_dir
readonly theme_dir="${SWAY_NOIR_THEME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/sway-noir/current}"
# Waybar expands the quoted include path in config.jsonc using this variable.
export SWAY_NOIR_THEME_DIR="$theme_dir"
readonly lock_command="$1"
readonly polkit_agent_command="$2"
shift 2

waybar_pid=""
mako_pid=""
reload_appearance() {
    local running
    running=$'\n'"$(jobs -pr)"$'\n'
    if [[ -n "$waybar_pid" && "$running" == *$'\n'"$waybar_pid"$'\n'* ]]; then
        kill -s USR2 "$waybar_pid" 2>/dev/null || true
    fi
    if [[ -n "$mako_pid" && "$running" == *$'\n'"$mako_pid"$'\n'* ]]; then
        makoctl reload || printf 'Warning: could not reload notification appearance.\n' >&2
    fi
}
trap reload_appearance USR2

valid_timeout() { [[ "$1" =~ ^(0|[1-9][0-9]{0,5})$ ]]; }

idle_lock_timeout="${SWAY_NOIR_IDLE_LOCK_TIMEOUT:-0}"
display_off_timeout="${SWAY_NOIR_LOCKED_DISPLAY_OFF_TIMEOUT:-0}"
if ! valid_timeout "$idle_lock_timeout"; then
    printf 'Warning: invalid idle lock timeout %s; automatic locking is disabled.\n' "$idle_lock_timeout" >&2
    idle_lock_timeout=0
fi
if ! valid_timeout "$display_off_timeout"; then
    printf 'Warning: invalid locked display-off timeout %s; displays stay on.\n' "$display_off_timeout" >&2
    display_off_timeout=0
fi

# swayidle runs each action through sh -c; quote the helper path for it.
printf -v display_helper '%q' "$profile_dir/session/idle-display"
idle_arguments=(-w)
if (( idle_lock_timeout > 0 )); then
    idle_arguments+=(timeout "$idle_lock_timeout" "$lock_command")
fi
if (( display_off_timeout > 0 )); then
    # Timeouts count from the last input: the first covers manual locks, the
    # second the automatic lock. The helper ignores both while unlocked.
    idle_arguments+=(timeout "$display_off_timeout" "$display_helper off-if-locked"
        resume "$display_helper on")
    if (( idle_lock_timeout > 0 )); then
        idle_arguments+=(timeout "$((idle_lock_timeout + display_off_timeout))"
            "$display_helper off-if-locked" resume "$display_helper on")
    fi
    idle_arguments+=(after-resume "$display_helper on")
fi
idle_arguments+=(before-sleep "$lock_command")
swayidle "${idle_arguments[@]}" &
waybar \
    --config "$theme_dir/waybar/config.jsonc" \
    --style "$theme_dir/waybar/style.css" &
waybar_pid=$!
mako --config "$theme_dir/mako/config" &
mako_pid=$!
if [[ -n "$polkit_agent_command" && "$polkit_agent_command" != true ]]; then
    "$profile_dir/session/polkit-agent" "$polkit_agent_command" &
fi
"$@" &

# Keep the service alive until its children exit. The default systemd
# KillMode=control-group also covers subprocesses when the service is stopped.
# A trapped signal interrupts wait. Keep supervising the existing children
# instead of exiting the service (which would kill all of its processes).
while true; do
    status=0
    wait || status=$?
    (( status > 128 )) || break
done
