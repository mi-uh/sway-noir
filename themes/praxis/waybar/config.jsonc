{
  "include": "\"${SWAY_NOIR_THEME_DIR}/waybar/base.jsonc\"",
  "height": 36,
  "fixed-center": true,
  "margin-left": 0,
  "margin-right": 0,
  "sway/mode": {"format": "{mode}"},
  "sway/window": {"max-length": 32, "align": 0.5},
  "cpu": {
    "format": "CPU {usage}",
    "align": 0.5,
    "justify": "center"
  },
  "custom/cpu": {
    "format": "CPU {}",
    "align": 0.5,
    "justify": "center"
  },
  "memory": {
    "format": "MEM {percentage:02}",
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },
  "custom/gpu": {
    "format": "GPU {}",
    "align": 0.5,
    "justify": "center"
  },
  "network": {
    "align": 0.5,
    "justify": "center",
    "format-wifi": "NET {signalStrength}",
    "format-ethernet": "NET ETH",
    "format-disconnected": "NET OFF"
  },
  "pulseaudio": {
    "align": 0.5,
    "justify": "center",
    "format": "VOL {volume}",
    "format-muted": "VOL MUTE"
  },
  "battery": {
    "align": 0.5,
    "justify": "center",
    "format": "PWR {capacity}",
    "format-charging": "PWR {capacity}+",
    "format-plugged": "PWR {capacity}+",
    "format-full": "PWR FULL"
  },
  "tray": {"spacing": 6, "icon-size": 16},
  "clock": {"align": 0.5}
}
