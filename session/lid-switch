#!/usr/bin/bash
set -euo pipefail

# Sway lid-switch actions, chosen by power source. run-apps holds a logind
# handle-lid-switch inhibitor while any action is not "system", so logind does
# not act on the lid itself.

usage() {
    printf 'Usage: %s close AC_ACTION BATTERY_ACTION LOCK_COMMAND... | open AC_ACTION BATTERY_ACTION\n' "$0" >&2
    printf 'Actions: suspend, lock, ignore, system\n' >&2
    exit 2
}

valid_action() { [[ "$1" =~ ^(suspend|lock|ignore|system)$ ]]; }

logind_true() {
    local reply
    reply="$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager "$1" 2>/dev/null)" || return 1
    [[ "$reply" == 'b true' ]]
}

apply() {
    case "$1" in
        suspend)
            # swayidle's before-sleep hook locks the screen before sleeping.
            systemctl suspend
            ;;
        lock)
            "${lock_command[@]}" || printf 'Warning: lock command failed.\n' >&2
            swaymsg -q 'output * power off'
            ;;
        ignore) ;;
    esac
}

(( $# >= 3 )) || usage
event="$1"
ac_action="$2"
battery_action="$3"
shift 3
if ! valid_action "$ac_action" || ! valid_action "$battery_action"; then
    usage
fi
[[ "$ac_action" != system || "$battery_action" != system ]] || exit 0
# Only one side managed: logind cannot act while inhibited, so use its default.
[[ "$ac_action" != system ]] || ac_action=suspend
[[ "$battery_action" != system ]] || battery_action=suspend

case "$event" in
    open)
        (( $# == 0 )) || usage
        exec swaymsg -q 'output * power on'
        ;;
    close)
        (( $# > 0 )) || usage
        lock_command=("$@")
        ;;
    *) usage ;;
esac

# While the lid stays closed, the watcher keeps the action matching the power
# source: unplugging or undocking applies it, and a laptop that wakes up with
# the lid closed suspends again after 3 polls (30 s by default), like logind.
# Polls only advance while awake, so time spent asleep does not count.
watch() {
    local applied="$1" wanted awake=0
    local interval="${SWAY_NOIR_LID_POLL_INTERVAL:-10}"
    [[ "$interval" =~ ^[1-9][0-9]{0,2}$ ]] || interval=10
    exec 9> "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sway-noir-lid.lock"
    flock -n 9 || exit 0
    while sleep "$interval" && logind_true LidClosed; do
        if logind_true Docked; then
            applied=docked
            continue
        fi
        wanted="$battery_action"
        ! logind_true OnExternalPower || wanted="$ac_action"
        if [[ "$wanted" != "$applied" ]] ||
           { [[ "$applied" == suspend ]] && (( ++awake >= 3 )); }; then
            # Actions must not inherit the lock, or a lock screen would hold it.
            apply "$wanted" 9>&-
            applied="$wanted"
            awake=0
        fi
    done
}

# Docked laptops are left alone, like logind does, until they are undocked.
if logind_true Docked; then
    watch docked
elif ! logind_true OnExternalPower; then
    apply "$battery_action"
    watch "$battery_action"
else
    apply "$ac_action"
    watch "$ac_action"
fi
