{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "reload_style_on_change": true,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "battery",
    "tray",
    "clock"
  ],
  "sway/workspaces": {
    "all-outputs": false,
    "disable-scroll": true,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "[{mode}]"
  },
  "sway/window": {
    "format": "{title}",
    "max-length": 50,
    "rewrite": {
      "(.*) - Mozilla Firefox": "$1",
      "(.*) - Visual Studio Code": "$1"
    }
  },
  "tray": {
    "spacing": 8
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "scroll-step": 2,
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "WIFI {signalStrength}%",
    "format-ethernet": "ETH",
    "format-disconnected": "NET down",
    "tooltip-format-wifi": "{essid} – {ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname} – {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 3,
    "tooltip": false
  },
  "memory": {
    "format": "RAM {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },
  "clock": {
    "format": "{:%d/%m · %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}%+",
    "format-plugged": "BAT {capacity}%+",
    "format-full": "BAT full"
  }
}
