#!/usr/bin/bash
set -euo pipefail

profile_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly profile_dir
readonly state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly state_dir="$state_home/sway-noir"
readonly current="$state_dir/current"
readonly default_theme=rain
readonly -a outputs=(sway.conf waybar/base.jsonc waybar/config.jsonc waybar/local.jsonc waybar/theme.jsonc waybar/colors.css waybar/style.css fuzzel/fuzzel.ini mako/config swaylock/config)
# Flat key=value templates may be adjusted by OUTPUT.override files.
readonly -a mergeable_outputs=(fuzzel/fuzzel.ini mako/config swaylock/config)
readonly max_inheritance_depth=8
declare -A values=()
theme_chain=()
generation=""
link_path=""

die() { printf 'Theme error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'Warning: %s\n' "$*" >&2; }

valid_id() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]; }

read_theme() {
    local file="$1" key value line
    [[ -f "$file" ]] || die "Missing theme: $file"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        [[ "$line" == *=* ]] || die "Expected key=value in $file"
        key="${line%%=*}"
        value="${line#*=}"
        case "$key" in
            bg|surface|surface_alt|border|accent|accent_surface|urgent|text|muted|input|selection|selection_text)
                [[ "$value" =~ ^#[[:xdigit:]]{6}$ ]] || die "Invalid color $key in $file"
                ;;
            gaps_inner|gaps_outer|border_width|radius|bar_radius|bar_button_radius|bar_margin_top|bar_margin_bottom)
                [[ "$value" =~ ^(0|[1-9][0-9]?)$ ]] || die "Invalid size $key in $file (expected 0..99)"
                ;;
            font_size|bar_font_size)
                [[ "$value" =~ ^[1-9][0-9]?$ ]] || die "Invalid size $key in $file (expected 1..99)"
                ;;
            inherits)
                valid_id "$value" || die "Invalid inherits in $file"
                ;;
            bar_position)
                [[ "$value" == top || "$value" == bottom ]] || die "Invalid bar_position in $file"
                ;;
            name|font)
                [[ "$value" =~ ^[[:alnum:]][[:alnum:]\ ._-]*$ ]] || die "Invalid $key in $file"
                ;;
            wallpaper|lock_wallpaper)
                [[ "$value" =~ ^[[:alnum:]_./\ -]+$ && "$value" != /* && "/$value/" != */../* ]] ||
                    die "Invalid asset path $key in $file"
                [[ "$value" == none || -f "$profile_dir/$value" ]] || die "Missing asset: $value"
                ;;
            *) die "Unknown theme key $key in $file" ;;
        esac
        values["$key"]="$value"
    done < "$file"
}

theme_parent() {
    local line parent=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" != inherits=* ]] || parent="${line#inherits=}"
    done < "$1"
    printf '%s\n' "${parent:-$default_theme}"
}

load_theme() {
    local id="$1" key theme seen index file
    valid_id "$id" || die "Invalid theme ID: $id"
    # Resolve id -> inherits -> ... -> Rain; Rain supplies every default.
    theme_chain=()
    theme="$id"
    while true; do
        valid_id "$theme" || die "Invalid parent theme ID: $theme"
        for seen in "${theme_chain[@]}"; do
            [[ "$seen" != "$theme" ]] || die "Theme inheritance cycle at $theme"
        done
        (( ${#theme_chain[@]} < max_inheritance_depth )) || die "Theme inheritance of $id is too deep"
        file="$profile_dir/themes/$theme/theme.conf"
        [[ -f "$file" ]] || die "Missing theme: $file"
        theme_chain+=("$theme")
        [[ "$theme" != "$default_theme" ]] || break
        theme="$(theme_parent "$file")"
    done
    values=()
    for (( index = ${#theme_chain[@]} - 1; index >= 0; index-- )); do
        read_theme "$profile_dir/themes/${theme_chain[index]}/theme.conf"
    done
    unset 'values[inherits]'
    for key in bg surface surface_alt border accent accent_surface urgent text muted input selection selection_text; do
        values["${key}_hex"]="${values[$key]#\#}"
    done
    if [[ "${values[wallpaper]}" == none ]]; then
        values[wallpaper_command]="output * background ${values[bg]} solid_color"
    else
        values[wallpaper_command]="output * background \"\$SWAY_NOIR_DIR/${values[wallpaper]}\" fill ${values[bg]}"
    fi
}

selected_id() {
    local id="$default_theme"
    if [[ -f "$current/theme-id" ]]; then
        IFS= read -r id < "$current/theme-id"
    fi
    valid_id "$id" || die 'Invalid saved theme ID.'
    # Preserve the renamed bundled selection without hiding a personal theme.
    if [[ "$id" == noir && ! -f "$profile_dir/themes/$id/theme.conf" ]]; then
        id="$default_theme"
    fi
    printf '%s\n' "$id"
}

valid_bar_position() { [[ "$1" == default || "$1" == top || "$1" == bottom ]]; }

selected_bar_position() {
    local position=default
    if [[ -f "$current/bar-position" ]]; then
        IFS= read -r position < "$current/bar-position"
    fi
    valid_bar_position "$position" || die 'Invalid saved Waybar position.'
    printf '%s\n' "$position"
}

bar_position_label() {
    case "$1" in
        default) printf '%s\n' 'Theme default' ;;
        top) printf '%s\n' 'Always top' ;;
        bottom) printf '%s\n' 'Always bottom' ;;
    esac
}

list_themes() {
    local file id
    for file in "$profile_dir"/themes/*/theme.conf; do
        [[ -f "$file" ]] || continue
        id="${file%/theme.conf}"
        id="${id##*/}"
        if valid_id "$id"; then printf '%s\n' "$id"; fi
    done
}

is_mergeable() {
    local output
    for output in "${mergeable_outputs[@]}"; do [[ "$output" != "$1" ]] || return 0; done
    return 1
}

# Append unused overrides of a section after its last non-empty line. Uses the
# caller's lines, order, overrides and used variables.
flush_override_section() {
    local section_name="$1" entry
    local -a trailing=()
    while (( ${#lines[@]} > 0 )) && [[ -z "${lines[-1]}" ]]; do
        trailing+=("")
        unset 'lines[-1]'
    done
    for entry in "${order[@]}"; do
        [[ "${entry%%$'\x1f'*}" == "$section_name" && -z "${used[$entry]+set}" ]] || continue
        lines+=("${entry#*$'\x1f'}=${overrides[$entry]}")
        used["$entry"]=1
    done
    lines+=("${trailing[@]}")
}

# Replace or add key=value lines from an override file in the given template,
# keeping the template's order and [section] structure.
apply_override() {
    local file="$1" line section="" key name stored
    local -A overrides=() used=()
    local -a order=() lines=()

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == [\#\;]* ]] && continue
        if [[ "$line" =~ ^\[([^][]+)\]$ ]]; then
            section="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^([[:alnum:]_.-]+)=(.*)$ ]]; then
            key="$section"$'\x1f'"${BASH_REMATCH[1]}"
            [[ -n "${overrides[$key]+set}" ]] || order+=("$key")
            overrides["$key"]="${BASH_REMATCH[2]}"
        else
            die "Expected key=value or [section] in $file"
        fi
    done < "$file"

    section=""
    while IFS= read -r line; do
        if [[ "$line" =~ ^\[([^][]+)\]$ ]]; then
            flush_override_section "$section"
            section="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^([[:alnum:]_.-]+)= ]]; then
            name="${BASH_REMATCH[1]}"
            key="$section"$'\x1f'"$name"
            if [[ -n "${overrides[$key]+set}" ]]; then
                line="$name=${overrides[$key]}"
                used["$key"]=1
            fi
        fi
        lines+=("$line")
    done <<< "$content"
    flush_override_section "$section"

    # Sections that the template does not define are added at the end.
    for key in "${order[@]}"; do
        [[ -z "${used[$key]+set}" ]] || continue
        section="${key%%$'\x1f'*}"
        lines+=("" "[$section]")
        for stored in "${order[@]}"; do
            [[ "${stored%%$'\x1f'*}" == "$section" ]] || continue
            lines+=("${stored#*$'\x1f'}=${overrides[$stored]}")
            used["$stored"]=1
        done
    done
    content="$(printf '%s\n' "${lines[@]}")"
}

render() {
    local id="$1" bar_position="$2" output source content key token margin_top theme override
    local -a template_overrides
    if [[ "$bar_position" != default && "$bar_position" != "${values[bar_position]}" ]]; then
        # Mirror vertical spacing when moving the bar to the opposite edge.
        margin_top="${values[bar_margin_top]}"
        values[bar_margin_top]="${values[bar_margin_bottom]}"
        values[bar_margin_bottom]="$margin_top"
        values[bar_position]="$bar_position"
    fi
    generation="$(mktemp -d "$state_dir/theme.XXXXXXXX")"
    for output in "${outputs[@]}"; do
        # theme.jsonc is only needed as the fallback behind personal overrides.
        [[ "$output" != waybar/theme.jsonc ]] || continue
        source="$profile_dir/$output"
        if [[ "$output" == waybar/local.jsonc && ! -e "$source" && ! -L "$source" ]]; then
            continue
        fi
        [[ "$output" != sway.conf ]] || source="$profile_dir/themes/sway.conf"
        # The nearest complete template wins; nearer overrides apply last.
        template_overrides=()
        if [[ "$output" != waybar/local.jsonc ]]; then
            for theme in "${theme_chain[@]}"; do
                if [[ -f "$profile_dir/themes/$theme/$output" ]]; then
                    source="$profile_dir/themes/$theme/$output"
                    break
                fi
                override="$profile_dir/themes/$theme/$output.override"
                if is_mergeable "$output" && [[ -f "$override" ]]; then
                    template_overrides=("$override" "${template_overrides[@]}")
                fi
            done
        fi
        [[ -f "$source" ]] || die "Missing template: $source"
        content="$(< "$source")"
        for override in "${template_overrides[@]}"; do apply_override "$override"; done
        # Bash 5.2's optional replacement expansion must not treat '&' as code.
        shopt -u patsub_replacement 2>/dev/null || true
        for key in "${!values[@]}"; do
            token="{{${key}}}"
            content="${content//"$token"/"${values[$key]}"}"
        done
        [[ "$content" != *'{{'* ]] || die "Unresolved token in $source"
        install -d -m 700 "$generation/$(dirname -- "$output")"
        printf '%s\n' "$content" > "$generation/$output"
    done
    if [[ -f "$generation/waybar/local.jsonc" ]]; then
        # Native includes merge recursively, with the first definition winning.
        # Snapshot local settings with the generation so rollback stays coherent.
        mv -- "$generation/waybar/config.jsonc" "$generation/waybar/theme.jsonc"
        # Leave environment references literal for Waybar's own path expansion.
        # shellcheck disable=SC2016
        printf '%s\n' '{' '  "include": [' \
            '    "\"${SWAY_NOIR_THEME_DIR}/waybar/local.jsonc\"",' \
            '    "\"${SWAY_NOIR_THEME_DIR}/waybar/theme.jsonc\""' \
            '  ]' '}' > "$generation/waybar/config.jsonc"
    fi
    if [[ "${values[lock_wallpaper]}" != none ]]; then
        printf 'image=%s/%s\n' "$profile_dir" "${values[lock_wallpaper]}" >> "$generation/swaylock/config"
    fi
    printf '%s\n' "$id" > "$generation/theme-id"
    printf '%s\n' "$bar_position" > "$generation/bar-position"
}

remove_generation() {
    local directory="$1" output
    # Delete only our known generated files, never a broad or user-given tree.
    [[ "${directory%/*}" == "$state_dir" && "${directory##*/}" =~ ^theme\.[[:alnum:]]{8}$ &&
       -d "$directory" && ! -L "$directory" ]] || return 0
    for output in "${outputs[@]}" theme-id bar-position; do rm -f -- "$directory/$output"; done
    rmdir -- "$directory/waybar" "$directory/fuzzel" "$directory/mako" "$directory/swaylock" "$directory" 2>/dev/null || true
}

cleanup() {
    [[ -z "$link_path" ]] || rm -f -- "$link_path"
    [[ -z "$generation" ]] || remove_generation "$generation"
}

activate() {
    local id="$1" live="$2" bar_position="${3:-saved}" previous="" reply
    [[ "$state_home" == /* ]] || die 'XDG_STATE_HOME must be an absolute path.'
    install -d -m 700 "$state_dir"
    exec 9> "$state_dir/theme.lock"
    flock -x 9
    trap cleanup EXIT
    # Refresh saved settings under the lock so concurrent changes are retained.
    if [[ "$id" == --saved ]]; then
        id="$(selected_id)"
        if [[ ! -f "$profile_dir/themes/$id/theme.conf" ]]; then
            warn "Saved theme $id is missing; using Rain."
            id="$default_theme"
        elif (( $# < 3 )) && ! reply="$(load_theme "$id" 2>&1)"; then
            # Login must not fail because a personal theme became invalid.
            warn "Saved theme $id is invalid; using Rain. ${reply#Theme error: }"
            id="$default_theme"
        fi
    fi
    if [[ "$bar_position" == saved ]]; then bar_position="$(selected_bar_position)"; fi
    valid_bar_position "$bar_position" || die "Invalid Waybar position: $bar_position"
    load_theme "$id"
    [[ ! -e "$current" || -L "$current" ]] || die "Refusing to replace non-symlink: $current"
    if [[ -L "$current" ]]; then previous="$(readlink -- "$current")"; fi
    render "$id" "$bar_position"
    # Even --validate initializes wlroots. Do not inherit the live session's
    # backend/renderer or require a working nested compositor and GPU here.
    if [[ "$live" == true ]] && ! reply="$(SWAY_NOIR_DIR="$profile_dir" \
        SWAY_NOIR_THEME_DIR="$generation" WLR_BACKENDS=headless WLR_RENDERER=pixman \
        sway --validate --config "$profile_dir/sway/config" 2>&1)"; then
        die "Sway configuration validation failed; selection unchanged. $reply"
    fi
    link_path="$state_dir/.current-${BASHPID}"
    ln -s -- "$generation" "$link_path"
    mv -Tf -- "$link_path" "$current"
    link_path=""
    if [[ "$live" == true ]]; then
        # -r makes any failed Sway command cause a nonzero exit, without jq.
        if ! reply="$(swaymsg -r reload 2>&1)"; then
            if [[ -n "$previous" ]]; then
                link_path="$state_dir/.current-${BASHPID}"
                ln -s -- "$previous" "$link_path"
                mv -Tf -- "$link_path" "$current"
                link_path=""
                swaymsg -r reload >/dev/null 2>&1 || true
            else
                rm -f -- "$current"
            fi
            die "Sway reload failed; previous selection restored. $reply"
        fi
        # Signal only this session's supervisor; it reloads its own Waybar/Mako.
        if ! systemctl --user kill --kill-whom=main --signal=USR2 \
            "sway-noir-apps-${SWAY_NOIR_SESSION_ID}.service"; then
            warn 'Appearance settings saved, but the desktop appearance reload could not be requested.'
        fi
    fi
    generation=""
    [[ -z "$previous" ]] || remove_generation "$previous"
    if [[ "${3:-saved}" == saved ]]; then
        printf '%s\n' "$id"
    else
        printf '%s\n' "$bar_position"
    fi
}

require_session() {
    [[ -n "${SWAYSOCK:-}" && "${SWAY_NOIR_SESSION_ID:-}" =~ ^[0-9]+-[0-9]+-[0-9]+$ &&
       "${SWAY_NOIR_THEME_DIR:-}" == "$current" ]] ||
        die 'Run this command inside Sway Noir (or use --no-reload when setting options for the next login).'
}

usage() {
    printf '%s\n' 'Usage: session/theme list | current | select | set ID [--no-reload] | init' \
        '       session/theme bar-position [default|top|bottom] [--no-reload]'
}

case "${1:-select}" in
    list) (( $# == 1 )) || die 'Unexpected arguments.'; list_themes ;;
    current) (( $# == 1 )) || die 'Unexpected arguments.'; selected_id ;;
    init) (( $# == 1 )) || die 'Unexpected arguments.'; activate --saved false ;;
    set|bar-position)
        if [[ "$1" == bar-position ]]; then
            if (( $# == 1 )); then selected_bar_position; exit 0; fi
            valid_bar_position "$2" || die "Invalid Waybar position: $2"
        fi
        (( $# == 2 || $# == 3 )) || { usage >&2; exit 2; }
        live=true
        if (( $# == 3 )); then
            [[ "$3" == --no-reload ]] || die "Unknown option: $3"
            live=false
        else
            require_session
        fi
        if [[ "$1" == bar-position ]]; then
            activate --saved "$live" "$2"
        else
            activate "$2" "$live"
        fi
        ;;
    select)
        (( $# <= 1 )) || die 'Unexpected arguments.'
        require_session
        # Display labels, but select by index so names cannot become commands.
        ids=()
        labels=()
        invalid=()
        while IFS= read -r id; do
            # One broken personal theme must not hide the whole menu.
            if label="$(load_theme "$id" 2>&1 && printf '%s (%s)' "${values[name]}" "$id")"; then
                ids+=("$id")
                labels+=("$label")
            else
                invalid+=("$label")
            fi
        done < <(list_themes)
        if (( ${#invalid[@]} > 0 )); then
            printf '%s\n' "${invalid[@]}" >&2
            swaynag -t warning -m 'Skipped invalid themes. See details below.' \
                --detailed-message <<< "$(printf '%s\n' "${invalid[@]}")" >/dev/null 2>&1 &
        fi
        position="$(selected_bar_position)"
        labels+=("Waybar position: $(bar_position_label "$position")")
        if ! index="$(printf '%s\n' "${labels[@]}" | fuzzel --dmenu --index \
            --config="$current/fuzzel/fuzzel.ini" --prompt='theme: ' )"; then
            exit 0
        fi
        [[ "$index" =~ ^(0|[1-9][0-9]*)$ && ${#index} -lt 6 ]] || die 'Invalid theme selection.'
        (( index < ${#labels[@]} )) || die 'Invalid theme selection.'
        if (( index == ${#ids[@]} )); then
            positions=(default top bottom)
            labels=()
            for option in "${positions[@]}"; do
                label="$(bar_position_label "$option")"
                [[ "$option" != "$position" ]] || label+=' (selected)'
                labels+=("$label")
            done
            if ! index="$(printf '%s\n' "${labels[@]}" | fuzzel --dmenu --index \
                --config="$current/fuzzel/fuzzel.ini" --prompt='waybar: ' )"; then
                exit 0
            fi
            [[ "$index" =~ ^(0|[1-9][0-9]*)$ && ${#index} -lt 6 ]] || die 'Invalid Waybar position selection.'
            (( index < ${#positions[@]} )) || die 'Invalid Waybar position selection.'
            command=(bar-position "${positions[index]}")
        else
            command=(set "${ids[index]}")
        fi
        # Run activation separately so all failures (including set -e errors)
        # can be shown when launched by a keybinding without a terminal.
        if ! reply="$("$profile_dir/session/theme" "${command[@]}" 2>&1)"; then
            printf '%s\n' "$reply" >&2
            # Activation has already exited and released its lock. The error
            # panel must not hold up cleanup or the next selection.
            swaynag -t error -m 'Could not apply appearance settings. See details below.' \
                --detailed-message <<< "$reply" >/dev/null 2>&1 &
            exit 1
        fi
        printf '%s\n' "$reply"
        ;;
    -h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
