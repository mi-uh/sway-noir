{
  "include": "\"${SWAY_NOIR_THEME_DIR}/waybar/base.jsonc\"",
  "height": 36,
  "fixed-center": true,
  "margin-left": 0,
  "margin-right": 0,
  "sway/mode": {"format": "{mode}"},
  "sway/window": {"max-length": 32, "align": 0.5},
  "cpu": {"align": 0.5, "justify": "center"},
  "custom/cpu": {"align": 0.5, "justify": "center"},
  "memory": {
    "align": 0.5,
    "justify": "center",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },
  "custom/gpu": {"align": 0.5, "justify": "center"},
  "network": {"align": 0.5, "justify": "center"},
  "pulseaudio": {"align": 0.5, "justify": "center"},
  "battery": {"align": 0.5, "justify": "center"},
  "tray": {"spacing": 6, "icon-size": 16},
  "clock": {"align": 0.5}
}
