# Sway Noir standalone configuration.
# Start it with: ~/.config/sway-noir/start-sway-noir

set $mod Mod4
set $left h
set $down j
set $up k
set $right l

# Sway's upstream default. Change this to use another terminal.
set $term foot
set $menu fuzzel --config=$SWAY_NOIR_DIR/fuzzel/fuzzel.ini

floating_modifier $mod normal

include config.d/*.conf
