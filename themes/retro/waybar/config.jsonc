{
  "include": "\"${SWAY_NOIR_THEME_DIR}/waybar/base.jsonc\"",
  "height": 32,
  "fixed-center": true,
  "margin-left": 0,
  "margin-right": 0,
  "sway/window": {"max-length": 36},
  "cpu": {"format": "CPU:{usage}"},
  "memory": {"format": "MEM:{percentage}"},
  "network": {
    "format-wifi": "WLAN:{signalStrength}",
    "format-ethernet": "LINK:UP",
    "format-disconnected": "LINK:DOWN"
  },
  "pulseaudio": {
    "format": "VOL:{volume}",
    "format-muted": "VOL:MUTE"
  },
  "battery": {
    "format": "PWR:{capacity}",
    "format-charging": "PWR:{capacity}+",
    "format-plugged": "PWR:{capacity}+",
    "format-full": "PWR:FULL"
  }
}
